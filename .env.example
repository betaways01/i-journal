# ============================================================
# Required
# ============================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# ============================================================
# Optional
# ============================================================

# Your Telegram ID (from @userinfobot). Set this to:
#   - Mark yourself as the owner (enables /testtrigger and OneNote sync for your account)
#   - Auto-migrate any legacy state/profile.json + state/journal.state.json into SQLite on first boot
# Leave empty if you are a new multi-user deployment.
TELEGRAM_OWNER_ID=

# Default timezone for users whose profile doesn't override it
TIMEZONE=Africa/Nairobi

NODE_ENV=development

# SQLite file location. Defaults to ./data/i-journal.db
# On Railway, mount a volume and point this at the mount (e.g. /data/i-journal.db)
DB_PATH=

# ============================================================
# OneNote cloud sync (optional, owner-only until per-user OAuth ships)
# ============================================================
# Leave all of these blank if you don't want OneNote sync.
# When set, only the owner (TELEGRAM_OWNER_ID) uses these tokens to sync.

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=consumers
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback
MICROSOFT_ACCESS_TOKEN=
MICROSOFT_REFRESH_TOKEN=
