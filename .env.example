# ============================================================
# Required
# ============================================================

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional dev/test bot token. When NODE_ENV is not production, this takes precedence locally.
TELEGRAM_BOT_TOKEN_TEST=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# ============================================================
# Optional
# ============================================================

# Your Telegram ID (from @userinfobot). Set this to:
#   - Mark yourself as the owner (enables /testtrigger and OneNote sync for your account)
#   - Auto-migrate any legacy state/profile.json + state/journal.state.json into SQLite on first boot
# Leave empty if you are a new multi-user deployment.
TELEGRAM_OWNER_ID=

# Default timezone for users whose profile doesn't override it
TIMEZONE=Africa/Nairobi

NODE_ENV=development

# SQLite file location. Defaults to ./data/i-journal.db
# On Railway, mount a volume and point this at the mount (e.g. /data/i-journal.db)
DB_PATH=

# ============================================================
# OneNote cloud sync (optional, owner-only until per-user OAuth ships)
# ============================================================
# Leave all of these blank if you don't want OneNote sync.
# When set, only the owner (TELEGRAM_OWNER_ID) uses these tokens to sync.

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Sign-in authority. 'common' = both personal (outlook/hotmail/live) and work/school accounts —
# recommended, so users connect whichever account's OneNote actually works. The app probes the
# OneNote connection at connect time and falls back to local saving if it can't reach OneNote.
# Note: Graph OneNote can fail for EITHER account type — the "Tenant does not have a SPO license"
# error is about licensing/provisioning/auth-context, not account type. 'consumers' (personal
# only) is a known fix for the specific case where a personal account is treated as an org guest;
# it requires the Azure app registration to allow personal accounts.
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/callback
MICROSOFT_ACCESS_TOKEN=
MICROSOFT_REFRESH_TOKEN=

# Optional override for the local OAuth callback web server.
# If port 3000 is already busy, set both PORT and MICROSOFT_REDIRECT_URI to the same free port.
PORT=3000
