# Deployment settings only. Nothing about a person goes here: name, timezone, facts and preferences
# live in each person's memory in the database (set by talking; see /memory, /reset).

# ============================================================
# Telegram
# ============================================================

# Bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Optional second bot for local testing; used instead of the one above when NODE_ENV is not production.
TELEGRAM_BOT_TOKEN_TEST=

# Your Telegram id (ask @userinfobot). The owner gets /debug, /export and setup hints, and owner
# keys sent with /key (e.g. DEEPSEEK_API_KEY) apply to the whole bot.
TELEGRAM_OWNER_ID=
# Others who may use the bot, comma-separated. People who already used the bot keep access.
# Everyone else gets one polite line and never reaches the model.
# TELEGRAM_ALLOWED_IDS=

# Keep Telegram updates that arrived while the bot was down (default). 1 = drop them on start.
# TELEGRAM_DROP_PENDING=0
# With a public https address in production, updates come by webhook. 0 = always poll.
# TELEGRAM_WEBHOOK=1

# ============================================================
# Model (required to think)
# ============================================================
# DeepSeek first, then OpenRouter, then any OpenAI-compatible endpoint. The owner can also send
#   /key DEEPSEEK_API_KEY your-key
# in Telegram (the bot deletes the message and stores the key encrypted).
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# PERSON_MODEL_URL= / PERSON_MODEL_KEY= / PERSON_MODEL_NAME=
# Set to 0 if your model cannot read images.
# PERSON_MODEL_IMAGES=1
# Prompt+completion tokens per person per day before the bot pauses until tomorrow (0 = no cap).
# PERSON_DAILY_TOKEN_CAP=3000000

# ============================================================
# Server
# ============================================================
NODE_ENV=development
# SQLite file. On Railway, mount a volume and point this at it (e.g. /data/i-journal.db).
DB_PATH=
# Fallback timezone for people who haven't said where they are.
TIMEZONE=UTC
# Web server port (Telegram webhook, Microsoft sign-in callback, /health).
PORT=3000
# Public https address, if the server has one (Railway's generated domain is picked up by itself).
# PUBLIC_URL=

# ============================================================
# OneNote (optional)
# ============================================================
# An Azure app registration ("Accounts in any organizational directory and personal Microsoft
# accounts"). Two ways to sign in, chosen automatically:
#   - Link: needs MICROSOFT_REDIRECT_URI = https://<your public address>/auth/callback, registered in
#     Azure under the "Web" platform (a "Single-page application" redirect only lasts 24 hours).
#   - Code (microsoft.com/devicelogin): works without a public address; needs Azure →
#     Authentication → "Allow public client flows" = Yes for personal accounts.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# 'common' lets personal and work/school accounts sign in directly. A single tenant id turns personal
# accounts into guests of that organization, and OneNote then fails for them.
MICROSOFT_TENANT_ID=common
# MICROSOFT_REDIRECT_URI=https://your-app.up.railway.app/auth/callback

# ============================================================
# Optional extras
# ============================================================
# Web search works without a key (Brave results page, then Wikipedia + Google News); a key is sturdier.
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# Voice notes (Groq has a free tier). Or send /key GROQ_API_KEY your-key in Telegram.
# GROQ_API_KEY=
# Encrypts keys stored with /key. Defaults to a value derived from the bot token.
# PERSON_SECRET_KEY=
# Replies that fill in while the model writes (default on). 0 = send once, finished.
# PERSON_STREAM=1
# CLI (npm run person:live) keeps its own store here.
# PERSON_CLI_DB=./state/person-cli.db
