{
  "name": "i-journal",
  "version": "1.0.0",
  "description": "A journaling companion in Telegram: one model loop, real tools, OneNote mirror.",
  "main": "dist/app.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "nodemon --ignore state/ --exec ts-node --transpile-only src/app.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/app.js",
    "test": "npm run -s typecheck:core && npm run -s test:core && npm run -s test:e2e",
    "test:core": "node --require ts-node/register/transpile-only --test \"tests/core/**/*.test.ts\" \"tests/bot/**/*.test.ts\"",
    "test:e2e": "node --require ts-node/register/transpile-only --test \"tests/e2e/**/*.test.ts\" \"tests/support/**/*.test.ts\"",
    "typecheck:core": "tsc -p tsconfig.test.json",
    "person:live": "ts-node --transpile-only src/cli/person.ts",
    "test:live": "LIVE=1 node --require ts-node/register/transpile-only --test \"tests/core/**/*.live.test.ts\"",
    "eval:live": "ts-node --transpile-only tests/live/eval.ts",
    "insights": "ts-node --transpile-only src/cli/insights.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^12.9.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
